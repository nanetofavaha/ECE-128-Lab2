module CarryAdder(
        input A, B, Cin,
        output S
    );
    
    assign S = (A^B^Cin);
    //assign Cout = (A&Cin)|(B&Cin)|(A&B);
    
endmodule


module CarryLookAhead(
    input [3:0] A, B,
    input cin,
    output s0, s1, s2, s3, cOut
);
 
    wire [3:0] P, G;
    wire [4:0] C;
    
    //P = A^B;
    assign P[0] = A[0]^B[0];
    assign P[1] = A[1]^B[1];
    assign P[2] = A[2]^B[2];
    assign P[3] = A[3]^B[3];
    
    //G = A&B;
    assign G[0] = A[0]&B[0];
    assign G[1] = A[1]&B[1];
    assign G[2] = A[2]&B[2];
    assign G[3] = A[3]&B[3];
    
    //Cn = G|(P&Cn-1)
    assign C[0] = cin;
    assign C[1] = G[0]|(P[0]&C[0]);
    //C[2] = G[1]|(P[1]&C[1]);
    assign C[2] = G[1]|(P[1]&(G[0]|(P[0]&C[0])));
    assign C[3] = G[2]|(P[2]&(G[1]|(P[1]&(G[0]|(P[0]&C[0])))));
    assign C[4] = G[3]|(P[3]&(G[2]|(P[2]&(G[1]|(P[1]&(G[0]|(P[0]&C[0])))))));
    
    
    wire c0,c1,c2;
    CarryAdder a0(A[0], B[0], C[0], s0);
    
    CarryAdder a1(A[1], B[1], C[1], s1);
    CarryAdder a2(A[2], B[2], C[2], s2);
    CarryAdder a3(A[3], B[3], C[3], s3);

